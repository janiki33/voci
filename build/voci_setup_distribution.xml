<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer-Beschreibung für Voci-Setup.pkg (productbuild).

  Wie das Windows-Setup legt der Installer die App an einem festen Ort ab,
  damit der eingebaute Updater weiss, was er austauschen muss. Zur Wahl
  stehen "nur für mich" (~/Applications, ohne Adminrechte) und "für alle
  Benutzer" (/Applications).
-->
<installer-gui-script minSpecVersion="2">
  <title>Voci</title>
  <organization>ch.janiki33</organization>
  <domains enable_localSystem="true" enable_currentUserHome="true"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <welcome file="willkommen.html" mime-type="text/html"/>
  <conclusion file="fertig.html" mime-type="text/html"/>
  <choices-outline>
    <line choice="default">
      <line choice="ch.janiki33.voci"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="ch.janiki33.voci" visible="false">
    <pkg-ref id="ch.janiki33.voci"/>
  </choice>
  <pkg-ref id="ch.janiki33.voci" onConclusion="none">Voci-Komponente.pkg</pkg-ref>
</installer-gui-script>
